digraph RestaurantUml {
 graph [rankdir=TB, bgcolor="#f8fafc", pad="0.45", nodesep="0.6", ranksep="0.9", splines=polyline,
        fontname="Arial", fontsize=25, labelloc=t, label="Restaurant Ordering System
UML class diagram", dpi=150];
 node [shape=plain, fontname="Arial", fontsize=12];
 edge [fontname="Arial", fontsize=11, color="#64748b", arrowsize=0.85];

Program [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#e2e8f0" CELLPADDING="10"><FONT POINT-SIZE="11">«static»</FONT><BR/><B>Program</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ Main(): void</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2563eb"><B>- CountChairs(table: Table): int</B></FONT></TD></TR><TR><TD ALIGN="LEFT">- DemonstrateLsp(): void</TD></TR></TABLE></TD></TR></TABLE>>];
subgraph cluster_core { label="Domain model"; fontsize=16; color="#cbd5e1"; style="rounded"; margin=22;
RestaurantFurniture [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#ede9fe" CELLPADDING="10"><B>RestaurantFurniture</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">- tables: List&lt;Table&gt;</TD></TR><TR><TD ALIGN="LEFT">- chairs: List&lt;Chair&gt;</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ GetTables(): IReadOnlyList&lt;Table&gt;</TD></TR><TR><TD ALIGN="LEFT">+ GetChairs(): IReadOnlyList&lt;Chair&gt;</TD></TR><TR><TD ALIGN="LEFT">+ GetOrders(): IReadOnlyList&lt;Order&gt;</TD></TR><TR><TD ALIGN="LEFT">+ AddTable(table: Table): void</TD></TR><TR><TD ALIGN="LEFT">+ RemoveTable(table: Table): void</TD></TR><TR><TD ALIGN="LEFT">+ AddChair(chair: Chair): void</TD></TR><TR><TD ALIGN="LEFT">+ RemoveChair(chair: Chair): void</TD></TR><TR><TD ALIGN="LEFT">+ OrderChair(chairId: int, customerName: string,</TD></TR><TR><TD ALIGN="LEFT">    customerPhone: string): Order</TD></TR><TR><TD ALIGN="LEFT">+ CancelOrder(orderId: int): void</TD></TR></TABLE></TD></TR></TABLE>>];
Table [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#dbeafe" CELLPADDING="10"><B>Table</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ Id: int {get}</TD></TR><TR><TD ALIGN="LEFT">- chairs: List&lt;Chair&gt;</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ GetShapeName(): string {virtual}</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2563eb"><B>+ GetTheNumberOfAttachedChairs(): int</B></FONT></TD></TR><TR><TD ALIGN="LEFT">+ GetChairs(): IReadOnlyList&lt;Chair&gt;</TD></TR><TR><TD ALIGN="LEFT">+ AddChair(chair: Chair): void</TD></TR><TR><TD ALIGN="LEFT">+ RemoveChair(chair: Chair): void</TD></TR></TABLE></TD></TR></TABLE>>];
Chair [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fef3c7" CELLPADDING="10"><B>Chair</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ Id: int {get}</TD></TR><TR><TD ALIGN="LEFT">+ Table: Table? {get; internal set}</TD></TR><TR><TD ALIGN="LEFT">- order: Order?</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ IsAvailable(): bool</TD></TR><TR><TD ALIGN="LEFT">+ GetOrder(): Order?</TD></TR><TR><TD ALIGN="LEFT">+ SetOrder(newOrder: Order?): void</TD></TR><TR><TD ALIGN="LEFT">~ AssignOrder(newOrder: Order?): void</TD></TR></TABLE></TD></TR></TABLE>>];
Order [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#fce7f3" CELLPADDING="10"><B>Order</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ Id: int {get}</TD></TR><TR><TD ALIGN="LEFT">- customerName: string</TD></TR><TR><TD ALIGN="LEFT">- customerPhone: string</TD></TR><TR><TD ALIGN="LEFT">- chairs: List&lt;Chair&gt;</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ AddChair(chair: Chair): void</TD></TR><TR><TD ALIGN="LEFT">+ RemoveChair(chair: Chair): void</TD></TR><TR><TD ALIGN="LEFT">+ GetChairs(): IReadOnlyList&lt;Chair&gt;</TD></TR><TR><TD ALIGN="LEFT">+ GetCustomerName(): string</TD></TR><TR><TD ALIGN="LEFT">+ GetCustomerPhone(): string</TD></TR></TABLE></TD></TR></TABLE>>];
RoundTable [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#dcfce7" CELLPADDING="10"><B>RoundTable</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ GetShapeName(): string {override}</TD></TR></TABLE></TD></TR></TABLE>>];
SquareTable [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#dcfce7" CELLPADDING="10"><B>SquareTable</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ GetShapeName(): string {override}</TD></TR></TABLE></TD></TR></TABLE>>];
RectangleTable [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#dcfce7" CELLPADDING="10"><B>RectangleTable</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ GetShapeName(): string {override}</TD></TR></TABLE></TD></TR></TABLE>>];
EliteChair [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#dcfce7" CELLPADDING="10"><B>EliteChair</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">- extraPrice: decimal</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ GetExtraPrice(): decimal</TD></TR></TABLE></TD></TR></TABLE>>];
{rank=same; Table; Chair; Order;}
 {rank=same; RoundTable; SquareTable; RectangleTable; EliteChair;}
 RestaurantFurniture -> Table [dir=both, arrowtail=odiamond, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.5];
 RestaurantFurniture -> Chair [dir=both, arrowtail=odiamond, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.5];
 RestaurantFurniture -> Order [style=dashed, label="derived via chairs", constraint=false];
 Table -> Chair [dir=both, arrowtail=odiamond, arrowhead=none, taillabel="0..1", headlabel="0..*", constraint=false, labeldistance=2.5];
 Chair -> Order [dir=none, taillabel="0..*", headlabel="0..1", constraint=false, labeldistance=2.5];
 Table -> RoundTable [dir=back, arrowtail=empty];
 Table -> SquareTable [dir=back, arrowtail=empty];
 Table -> RectangleTable [dir=back, arrowtail=empty];
 Chair -> EliteChair [dir=back, arrowtail=empty];
}
subgraph cluster_storage { label="JSON persistence"; fontsize=16; color="#cbd5e1"; style="rounded"; margin=22;
RestaurantStorage [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#e2e8f0" CELLPADDING="10"><FONT POINT-SIZE="11">«static»</FONT><BR/><B>RestaurantStorage</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ Save(restaurant: RestaurantFurniture, path: string): void</TD></TR><TR><TD ALIGN="LEFT">+ Load(path: string): RestaurantFurniture</TD></TR></TABLE></TD></TR></TABLE>>];
RestaurantData [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#e2e8f0" CELLPADDING="10"><FONT POINT-SIZE="11">«nested DTO»</FONT><BR/><B>RestaurantData</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ Tables: List&lt;TableData&gt;</TD></TR><TR><TD ALIGN="LEFT">+ Chairs: List&lt;ChairData&gt;</TD></TR><TR><TD ALIGN="LEFT">+ Orders: List&lt;OrderData&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
TableData [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#e2e8f0" CELLPADDING="10"><FONT POINT-SIZE="11">«nested DTO»</FONT><BR/><B>TableData</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ Id: int</TD></TR><TR><TD ALIGN="LEFT">+ Shape: string</TD></TR></TABLE></TD></TR></TABLE>>];
ChairData [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#e2e8f0" CELLPADDING="10"><FONT POINT-SIZE="11">«nested DTO»</FONT><BR/><B>ChairData</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ Id: int</TD></TR><TR><TD ALIGN="LEFT">+ TableId: int?</TD></TR><TR><TD ALIGN="LEFT">+ ExtraPrice: decimal?</TD></TR></TABLE></TD></TR></TABLE>>];
OrderData [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD BGCOLOR="#e2e8f0" CELLPADDING="10"><FONT POINT-SIZE="11">«nested DTO»</FONT><BR/><B>OrderData</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="8"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT">+ Id: int</TD></TR><TR><TD ALIGN="LEFT">+ CustomerName: string</TD></TR><TR><TD ALIGN="LEFT">+ CustomerPhone: string</TD></TR><TR><TD ALIGN="LEFT">+ ChairIds: List&lt;int&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
RestaurantStorage -> RestaurantData [style=dashed, label="serializes / restores"];
 RestaurantData -> TableData [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.5];
 RestaurantData -> ChairData [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.5];
 RestaurantData -> OrderData [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.5];
}
Program -> RestaurantFurniture [style=dashed, label="console use cases"];
 Program -> RestaurantStorage [style=dashed, label="save / load"];
 RestaurantStorage -> RestaurantFurniture [style=dashed, constraint=false];
 Legend [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>Notation</B></TD></TR><TR><TD ALIGN="LEFT">+ public   - private   ~ internal   ? nullable</TD></TR><TR><TD ALIGN="LEFT">Hollow triangle: inheritance   Hollow diamond: aggregation</TD></TR><TR><TD ALIGN="LEFT">Solid diamond: composition   Dashed arrow: dependency</TD></TR><TR><TD ALIGN="LEFT">Constructors and console helper methods are omitted.</TD></TR><TR><TD ALIGN="LEFT">DTO classes are nested in RestaurantStorage.</TD></TR><TR><TD ALIGN="LEFT">LSP: CountChairs(Table) accepts all three table subclasses.</TD></TR></TABLE>>];
 RectangleTable -> Legend [style=invis];
 OrderData -> Legend [style=invis];
}
